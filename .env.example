SHOPEE_APP_NAME=Shopee AI Commerce Agent
# Phase 1 default (SQLite) | Phase 2+ production (PostgreSQL):
# SHOPEE_DATABASE_URL=postgresql+psycopg://shopbot:shopbot@localhost:5432/shopbot
SHOPEE_DATABASE_URL=sqlite:///./shopee_ai_agent.db
SHOPEE_MOCK_CATALOG_PATH=data/mock_products.json
SHOPEE_DEFAULT_SPENDING_LIMIT_PKR=50000
SHOPEE_MAX_QUANTITY_PER_ORDER=10
SHOPEE_RATE_LIMIT_PER_MINUTE=30
# Phase 6 — deployment hardening
SHOPEE_CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501  # comma-separated; never "*" in prod
SHOPEE_CHECKPOINTER_PATH=./shopee_checkpoints.db  # persistent LangGraph checkpointer (survives restarts)
# mock (Phase 1 default) | official (Phase 5 — real Shopee Open Platform v2,
# unauthorized until the credentials below are configured)
SHOPEE_SHOPEE_CLIENT=mock
# Phase 5 — Shopee Open Platform credentials (secrets: env/secret storage only)
SHOPEE_SHOPEE_PARTNER_ID=
SHOPEE_SHOPEE_PARTNER_KEY=
SHOPEE_SHOPEE_SHOP_ID=
SHOPEE_SHOPEE_ACCESS_TOKEN=          # shop access token (valid 4h — refresh via /api/v2/auth/access_token/get)
SHOPEE_SHOPEE_BASE_URL=https://partner.shopeemobile.com
# sandbox: https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_SHOPEE_CATEGORY_ID=           # Shopee category id for new listings (required for most categories)
SHOPEE_WHATSAPP_VERIFY_TOKEN=change-me
# Phase 4 — WhatsApp Business Cloud API
SHOPEE_WHATSAPP_CLIENT=mock            # mock | cloud (real Meta Graph API)
SHOPEE_WHATSAPP_ACCESS_TOKEN=          # Meta access token (cloud mode)
SHOPEE_WHATSAPP_PHONE_NUMBER_ID=      # your WhatsApp phone number ID (cloud mode)
SHOPEE_WHATSAPP_APP_SECRET=           # verifies X-Hub-Signature-256 on inbound webhooks
SHOPEE_WHATSAPP_API_VERSION=v21.0
# Phase 3 — AI orchestration (Ollama local model, rule-based fallback)
SHOPEE_LLM_PROVIDER=ollama
SHOPEE_OLLAMA_BASE_URL=http://localhost:11434
SHOPEE_OLLAMA_MODEL=llama3.2
SHOPEE_OLLAMA_TIMEOUT_SECONDS=30
SHOPEE_LLM_FALLBACK_TO_RULES=true
# Used by the Streamlit dashboard (app.py)
BACKEND_URL=http://localhost:8000
